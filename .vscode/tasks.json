{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "build ssb detect program",
			"command": "bash build.sh",
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "compiler: /usr/bin/gcc"
		},
		{
			"type": "shell",
			"label": "Run ssb decode",
			"command": "./cellSearch",
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			],
			"detail": "run ssb decode program"
		}
	]
}